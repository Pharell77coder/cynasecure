# Flask
SECRET_KEY=change-moi-en-une-vraie-cle-aleatoire-longue
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Base de données Postgres (Neon, Supabase, ou le service "db" du docker-compose en local)
# Format : postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://cyna:cyna@localhost:5432/cynasecure

# Gmail SMTP (remplace Maildev)
# MAIL_PASSWORD = mot de passe d'application Google (pas ton mot de passe Gmail normal)
# À générer sur https://myaccount.google.com/apppasswords (nécessite la validation en 2 étapes activée)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=ton-adresse@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_DEFAULT_SENDER=noreply@cyna.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Contact
CONTACT_RECIPIENT_EMAIL=support@cyna.fr

# CORS : origines autorisées, séparées par une virgule (URLs Vercel en prod)
CORS_ORIGINS=https://ton-frontend.vercel.app,https://ton-backoffice.vercel.app

# Cookies cross-domain (front Vercel <-> backend sur un autre domaine) : obligatoire en prod HTTPS
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=True
