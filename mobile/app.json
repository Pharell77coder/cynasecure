{
  "expo": {
    "name": "Cyna",
    "slug": "cyna-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B74"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.cyna.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Cyna utilise la caméra pour scanner des documents.",
        "NSPhotoLibraryUsageDescription": "Cyna accède aux photos pour les pièces jointes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B74"
      },
      "package": "fr.cyna.mobile",
      "permissions": ["NOTIFICATIONS", "VIBRATE"]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7B3FE4",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:8000/api"
    }
  }
}
